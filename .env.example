# Alpaca Paper Trading Credentials
# Get these from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Alpha Vantage (earnings calendar)
# Free key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_key_here

# News sources (all free tiers)
# Finnhub — economic calendar + market news (60 calls/min free)
FINNHUB_API_KEY=your_key_here

# GNews — business headlines (100 calls/day free)
# Free key: https://gnews.io/
GNEWS_API_KEY=your_key_here

# Currents API — financial/macro news (1,000 calls/day free)
# Free key: https://currentsapi.services/
CURRENTS_API_KEY=your_key_here

# Marketaux — stock-specific news (100 calls/day free, optional)
# Free key: https://www.marketaux.com/
MARKETAUX_API_KEY=your_key_here

# Risk Settings (adjust these)
MAX_PORTFOLIO_RISK_PCT=0.02       # Max 2% of portfolio per trade
MAX_OPEN_POSITIONS=10             # Max concurrent positions
MAX_DAILY_LOSS_PCT=0.05           # Kill switch: halt if down 5% on the day
