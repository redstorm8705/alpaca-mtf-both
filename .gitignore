# Added by code-review-graph
.code-review-graph/

# ── Secrets & credentials ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets/

# ── Claude Code local config (settings.local.json may have permissions/tokens) ─
# .claude/ is ignored EXCEPT the ship-gate machinery and the hook registration.
# 2026-07-22: the entire preship gate existed only on one Mac — not in git, never on OCI,
# and therefore absent from Rafael's second Claude account. An unversioned enforcement
# mechanism does not exist for anyone but its author, which defeats its purpose. The
# scripts read every credential from the environment (verified: no literal keys).
# settings.local.json stays ignored — machine-local permissions.
.claude/*
!.claude/preship/
.claude/preship/*
!.claude/preship/*.py
!.claude/settings.json
.claudeignore
.mcp.json
.token-savior-cache.json

# ── Python runtime ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/

# ── Runtime state (position data, session state) ───────────────────────────────
data/state/
data/cache/
# Config is stable quarterly configuration, not volatile runtime state — track it
!data/state/quarterly_holds_config.json

# ── Trade data (P&L history, open positions) ───────────────────────────────────
trade_log.json
trade_log.json.bak
trade_events.jsonl

# ── Logs: exclude everything by default, whitelist CCR-useful docs only ─────────
# NOTE: must use logs/* (not logs/) so negation rules below can un-ignore specific files.
# Using logs/ ignores the directory itself, making negation rules unreachable.
logs/*
# Whitelisted docs for CCR agent context:
!logs/tb_audit_log.md
!logs/qhm_v2_design_2026-07-11.md
!logs/overnight_work_order_2026-07-12.md
!logs/bot_improvements.md
!logs/july_trade_audit_2026-07.md
!logs/weekly_perf_audit_design_v1.md
!logs/bug_counter.json
!logs/project-state.md
!logs/protocol_violations.md
!logs/queued_for_review_*.md
# Whitelisted for autonomous pipeline (CCR drafts → OCI DS/GAI → session approval):
!logs/pending_ds_gai_*.json
!logs/pending_patch_*.patch
!logs/pending_approvals_*.md
# Whitelisted for research memos (quarterly holds, session analysis):
!logs/quarterly_holds_research_*.md
# Whitelisted for failure log (approach history across sessions):
!logs/ERRORS.md
# Whitelisted for MTF FULL BOT AUDIT — JUNE 26 (standing multi-session audit initiative):
!logs/mtf_full_bot_audit/
!logs/mtf_full_bot_audit/*
# Whitelisted for Self-QA gate #4 design records (record_design.py --doc target). These are
# the actual audit-trail artifact the "BGG design-record" mechanism leans on — unlike the
# ephemeral, per-machine marker JSONs under .claude/preship/markers/ (intentionally gitignored,
# same as every other marker type), this .md content is meant to survive in git history.
!logs/design_records/
!logs/design_records/*
# Whitelisted for interactive→API build-package scope docs and session decision queues:
!logs/api_build_packages_*.md
!logs/pending_claude_session_*.md
!logs/f6_activation_BLOCKED_*.md
!logs/f6_prereq*_design_*.md
!logs/reports_durability_design_*.md
!logs/session_checkpoint.md
# Routine cron report outputs — durable cross-account persistence (Option B, board 3-1 + Gro,
# 2026-07-18). Un-ignored so scripts/sync_reports.py can commit them → any account's `git pull`
# sees 100% of routine AUDIT reports. See logs/reports_durability_design_2026-07-18.md.
# (weekly_*.html / monthly_*.html dashboards stay under the global *.html ignore — they are
# human-facing, served via the OCI web server, and regenerate daily; a separate decision.)
!logs/gemini_audit_*.txt
!logs/midday_audit_*.json
!logs/midday_gemini_*.txt
!logs/meta_audit_latest.json
!logs/ai_audit_meta_*.json
!logs/gex_daily_audit_*.json
!logs/wtp_*.md
!logs/weekly_audit_rollup_*.md
!logs/score16_report.json

