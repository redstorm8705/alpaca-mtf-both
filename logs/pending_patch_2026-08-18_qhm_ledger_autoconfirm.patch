# CHANGE 3: execution/quarterly_hold_manager.py
# T2 hook in _execute_earnings_trim_tier2
# Insert AFTER logger.warning("QHM EARNINGS-TRIM TIER2: ...") line
# and BEFORE try: self._alert(...)
# (approximately line 2550 in the original file)
#
# KEY DESIGN: T2 polls for fill settlement (≤10s) before writing the confirm,
# mirroring T1's pattern. close_position() returns True on SUBMISSION, not fill.
# Writing net_at_confirm before settlement produces a stale mismatch at sync time.
# Board B+C+A all converged on this fix.
# ============================================================

# --- INSERT (T2 hook, after logger.warning("QHM EARNINGS-TRIM TIER2: ...")) ---

            # QHM → ledger auto-confirm (design record 2026-08-12): T2 full exit.
            # SETTLE POLL: close_position() returns True on submission, not fill.
            # Writing the confirm before the fill settles causes net_at_confirm !=
            # live_net at sync time → match rejected → confirm useless (Board B+C+A
            # unanimous, 2026-08-18). Poll up to 10s for net=0 before writing.
            # If poll times out (fill not settled within 10s), skip — manual path.
            try:
                import time as _t2_time
                _t2_deadline = _t2_time.monotonic() + 10.0
                _t2_time.sleep(2)  # initial 2s — covers the typical fast-fill case
                _t2_net = self._earnings_trim_broker_qty(pos)
                while _t2_time.monotonic() < _t2_deadline:
                    if _t2_net is not None and _t2_net == 0:
                        break
                    _t2_time.sleep(1)
                    _t2_net = self._earnings_trim_broker_qty(pos)

                if _t2_net is not None and _t2_net == 0:
                    # Fill confirmed. Write the ledger confirm for floor 0.
                    try:
                        from execution.ownership_guard import _record_system_heal_confirmation as _rhc
                        _auto_ok = _rhc(pos.symbol, "qhm", 0.0, "earnings_trim_auto")
                        if _auto_ok:
                            logger.info(
                                "QHM earnings-trim: %s tier2 ledger heal-confirm written "
                                "(target_qty=0, source=earnings_trim_auto)", pos.symbol)
                        else:
                            logger.warning(
                                "QHM earnings-trim: %s tier2 ledger heal-confirm NOT written "
                                "(broker read in helper failed) — manual confirm needed.",
                                pos.symbol)
                    except Exception as _rhc_e:  # RC-3: fail-soft
                        logger.warning(
                            "QHM earnings-trim: %s tier2 _record_system_heal_confirmation "
                            "error: %s (manual ledger confirm needed).", pos.symbol, _rhc_e)
                else:
                    # Fill not confirmed within poll window — skip auto-confirm.
                    # Guard will still REFUSE the ledger shrink; operator must
                    # run confirm_ledger_heal.py after verifying the fill in Alpaca.
                    logger.warning(
                        "QHM earnings-trim: %s tier2 fill NOT confirmed within 10s poll "
                        "(broker_net=%s) — ledger heal-confirm skipped; manual confirm "
                        "needed after verifying fill in Alpaca.", pos.symbol, _t2_net)
            except Exception as _t2_poll_e:  # RC-3: fail-soft; exit already recorded
                logger.warning(
                    "QHM earnings-trim: %s tier2 settle poll/confirm error: %s "
                    "(manual ledger confirm needed).", pos.symbol, _t2_poll_e)

