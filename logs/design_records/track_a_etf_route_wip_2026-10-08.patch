+        for etf in ("NVDL", "NVDU", "NVD", "TSLL", "MSFD", "TQQQ", "SQQQ"):
+            self.assertEqual(dtm._min_entry_qty(etf, 1), 2, etf)
+
+    def test_bad_min_is_one(self):
+        for bad in (None, "x", 0, -3):
+            self.assertEqual(dtm._min_entry_qty("NVDA", bad), 1)
+
+
