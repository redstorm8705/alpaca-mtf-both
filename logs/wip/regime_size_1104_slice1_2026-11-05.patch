+# ruff: noqa: E501
+"""REGIME-SIZE-1104 slice 1: the regime layer's VIX is the CBOE index itself (Schwab $VIX, then the T4
+yfinance chart), each with its own as-of time; SPY realized vol is a separate series and never stands in
+for VIX. All network calls are mocked; nothing reaches a broker or a data vendor."""
+import logging
+import math
+import unittest
+from datetime import datetime, timedelta, timezone
+from unittest import mock
+
+import pandas as pd
+
+import config
+import strategy.volatility_regime as vr
+from data import schwab_quotes as sq
+
+UTC = timezone.utc
+NOW = datetime(2026, 11, 5, 18, 0, 0, tzinfo=UTC)
+TTL = 2 * float(config.SCAN_INTERVAL_INTRADAY) * 60
+
+
+class _FixedDT(datetime):
+    @classmethod
+    def now(cls, tz=None):
+        return NOW if tz is None or tz is UTC else NOW.astimezone(tz)
+
+
+def _iq(last, age_s=10.0):
+    t = NOW - timedelta(seconds=age_s)
+    return sq.IndexQuote(symbol="$VIX", last=last, trade_time=t, fetch_time=NOW, age_s=age_s,
+                         max_age_s=TTL, latency_s=0.1)
+
+
+def _yf_resp(price, ts):
+    r = mock.Mock()
+    r.status_code = 200
+    meta = {"regularMarketPrice": price}
+    if ts is not None:
+        meta["regularMarketTime"] = ts
+    r.json.return_value = {"chart": {"result": [{"meta": meta, "indicators": {"quote": [{"close": [price]}]}}]}}
+    return r
+
+
+def _spy_bars():
+    closes = [500 * (1 + 0.01 * ((-1) ** i)) for i in range(15)]
+    return pd.DataFrame({"close": closes})
+
+
+class VixSourceTests(unittest.TestCase):
+    def setUp(self):
+        self.p_dt = mock.patch.object(vr, "datetime", _FixedDT)
+        self.p_dt.start()
