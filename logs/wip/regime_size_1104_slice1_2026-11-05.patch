+def _quote_ttl_seconds() -> float:
+    """Time-to-live of a VIX quote: fresh while its own as-of time is within two scan intervals of
+    now (design REGIME-SIZE-1104 rev 3: this cycle's reading or the previous cycle's)."""
+    scan_seconds = _scan_seconds()
+    quote_ttl_seconds = 2 * scan_seconds
+    return quote_ttl_seconds
+
+
+def _valid_age(value) -> "float | None":
+    try:
+        a = float(value)
+    except (TypeError, ValueError):
+        return None
+    if not math.isfinite(a) or a < 0:
+        return None
+    return a
+
+
+def _valid_vix(value) -> "float | None":
+    try:
+        v = float(value)
+    except (TypeError, ValueError):
+        return None
+    if not math.isfinite(v) or v <= 0:
+        return None
+    return v
