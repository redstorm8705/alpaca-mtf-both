+    ni, rev, fcf = f.get("net_income_ttm"), f.get("revenue_ttm"), f.get("fcf_ttm")
+    if ni and ni > 0:
+        out["pe"] = mcap / ni
+    if rev and rev > 0:
+        out["ps"] = mcap / rev
+    if fcf is not None:
+        out["fcf_yield"] = fcf / mcap * 100.0
+    return out
+
+
+def fundamentals_takeaway(f: dict, sic: str = "") -> str:
+    """The business in plain English from the filed figures: a verdict, then growth,
+    profit, per-share earnings trend and cash — each with its number. `sic` is the SEC
+    industry code: for finance companies (6xxx) free cash flow is left out, because a
+    lender's operating cash flow counts the loans it makes as cash going out."""
+    if not f:
+        return "No SEC filing data is available for this company."
+    bits: list[str] = []
+    good = known = 0
+    yoy, rq = f.get("revenue_yoy_pct"), f.get("revenue_q")
+    if yoy is not None:
+        known += 1
+        good += yoy >= 5
+        word = ("growing fast" if yoy >= 20 else "growing" if yoy >= 5
+                else "roughly flat" if yoy > -5 else "shrinking")
+        last_q = f", {_money(rq)} last quarter" if rq is not None else ""
+        bits.append(f"sales are {word} ({yoy:+.0f}% from a year ago{last_q})")
+    elif rq is not None:
+        bits.append(f"sales were {_money(rq)} last quarter (no year-ago figure filed)")
+    ni = f.get("net_income_ttm")
+    if ni is not None:
+        known += 1
+        if ni > 0:
+            good += 1
+            om = f.get("op_margin_pct")
+            margin = f", {om:.0f}% operating margin last quarter" if om is not None else ""
+            bits.append(f"it is profitable ({_money(ni)} net income over the last 12 months{margin})")
+        else:
+            bits.append(f"it is losing money ({_money(ni)} net income over the last 12 months)")
+    ey = f.get("eps_yoy_pct")
+    if ey is not None and abs(ey) >= 10:
+        caveat = (" — a jump that large usually includes one-time items, so check before relying on it"
+                  if ey >= 100 else "")
+        bits.append(f"earnings per share are {'up' if ey > 0 else 'down'} {abs(ey):.0f}% from a year ago{caveat}")
+    fcf = None if sic.startswith("6") else f.get("fcf_ttm")
+    if fcf is not None:
+        known += 1
+        if fcf > 0:
+            good += 1
+            bits.append(f"it generates cash ({_money(fcf)} free cash flow over 12 months)")
+        else:
+            bits.append(f"it is burning cash ({_money(fcf)} free cash flow over 12 months)")
+    if not bits:
+        return "The filings don't report enough to judge the business."
+    if known == 0:
+        verdict = "Limited data"
+    elif good == known:
+        verdict = "Strong"
+    elif good == 0:
+        verdict = "Weak"
+    elif good / known >= 0.6:
+        verdict = "Mostly healthy"
+    else:
+        verdict = "Mixed"
+    return (f"{verdict}: " + "; ".join(bits)
+            + f" (latest filing: quarter ended {f.get('period_end', '?')}).")
+
+
+def peer_comp(sym: str, sic: dict, eps: dict, price: dict, members: list,
+              withheld: frozenset = frozenset()) -> dict:
+    """P/E vs same-industry S&P 500 peers on one earnings basis (the last full fiscal
+    year, SEC-filed). All maps are keyed by class-A ticker. Peers share the company's
+    4-digit SEC industry code, widening once to 3 digits, until >= _PEER_MIN peers have
+    a positive EPS and a price (never wider: 2-digit groups mix unrelated businesses).
+    `withheld` = tickers whose annual EPS may predate a stock split (excluded).
+    Returns {} without an industry code; 'peers' is [] when too few peers exist.
+    'status' says why the company's own P/E is missing, if it is."""
+    sym = _CLASS_A.get(sym, sym)
+    own = sic.get(sym, "")
+    if len(own) < 3:
+        return {}
+    out: dict = {"sic": own, "peers": []}
+    e, p = eps.get(sym), price.get(sym)
+    if sym in withheld:
+        out["status"] = "split"
+    elif e is None:
+        out["status"] = "no_eps"
+    elif e <= 0:
+        out["status"] = "loss"
+    elif not p:
+        out["status"] = "no_price"
+    else:
+        out["status"] = "ok"
+    for digits in (4, 3):
+        prefix = own[:digits]
+        peers = []
+        for t in members:
+            t = _CLASS_A.get(t, t)
+            if (t == sym or t in withheld or len(sic.get(t, "")) < digits
+                    or sic[t][:digits] != prefix):
+                continue
+            pe_, pp = eps.get(t), price.get(t)
+            if pe_ is not None and pe_ > 0 and pp:
+                peers.append((t, pp / pe_))
+        peers = sorted(set(peers), key=lambda x: x[1])
+        if len(peers) >= _PEER_MIN:
+            out.update(peers=peers, digits=digits,
+                       median=statistics.median(v for _, v in peers))
+            if out["status"] == "ok" and e and p:
+                out["pe"] = p / e
+                out["vs_peers_pct"] = (out["pe"] / out["median"] - 1.0) * 100.0
+            return out
+    return out
+
+
+def _range_line(m: dict) -> str | None:
+    """Where the last close sits in its 52-week range (same bars, same share class)."""
+    last, hi, lo = m.get("last"), m.get("high52"), m.get("low52")
+    if not (last and hi and lo):
+        return None
+    below = (1 - last / hi) * 100
+    above = (last / lo - 1) * 100
+    top = "at its 52-week high" if below <= 0.5 else f"{below:.0f}% below its 52-week high"
+    bottom = "at its 52-week low" if above <= 0.5 else f"{above:.0f}% above its low"
+    return f"{top} (${hi:,.2f}) and {bottom} (${lo:,.2f})"
+
+
+def valuation_takeaway(sym: str, price: float | None, f: dict, peer: dict,
+                       year: int | None, m: dict, splits: list | None = None) -> str:
+    """Valuation in plain English: cheap / in line / expensive vs peers (class-A price,
+    last full year's earnings), the 12-month P/E, market value and the 52-week range.
+    `splits` = the company's recent split dates (None = the lookup failed): a P/E is
+    withheld whenever a split may have left the earnings on the old share count."""
+    cls = _CLASS_A.get(sym, sym)
+    who = f" (class A, {cls})" if cls != sym else ""
+    parts: list[str] = []
+    peers = peer.get("peers") or []
+    names = ", ".join(t for t, _ in peers[:_PEERS_SHOWN]) + (", …" if len(peers) > _PEERS_SHOWN else "")
+    where = ("the same SEC industry" if peer.get("digits") == 4
+             else "a related SEC industry group")
+    group = f"{len(peers)} S&P 500 peers in {where} ({names})"
+    yr = str(year) if year else "last year"
+    status = peer.get("status")
+    if peer.get("pe") is not None:
+        diff = peer["vs_peers_pct"]
+        label = ("Cheap vs peers" if diff <= _CHEAP_PCT else
+                 "Expensive vs peers" if diff >= _RICH_PCT else "In line with peers")
+        gap = ("about the same as them" if abs(diff) < 1
+               else f"{abs(diff):.0f}% {'below' if diff < 0 else 'above'} them")
+        parts.append(f"{label}: at ${price:,.2f}{who} it trades at {peer['pe']:.1f}× its {yr} earnings vs "
+                     f"a median {peer['median']:.1f}× for {group} — {gap}")
+    elif peers:
+        why = {"loss": f"it lost money in {yr}",
+               "split": f"a stock split since its {yr} results means the filed earnings per share "
+                        f"may not match today's share count",
+               "no_price": "no current price was available this run",
+               }.get(str(status), f"its SEC data has no {yr} diluted earnings per share")
+        parts.append(f"No P/E: {why}; {group} trade at a median {peer['median']:.1f}× earnings")
+    elif peer:
+        parts.append("No peer comparison: fewer than 3 profitable S&P 500 companies share its SEC "
+                     "industry group")
+    else:
+        parts.append("No peer comparison available this run")
+    eps_ttm = f.get("eps_ttm")
+    fy_end = f.get("eps_fy_end")
+    recent = (datetime.now(ET).date() - timedelta(days=460)).isoformat()
+    split_risk = splits is None or any(d > (fy_end or recent) for d in splits)
+    if eps_ttm is not None and eps_ttm > 0 and price and not split_risk:
+        parts.append(f"on the last 12 months of earnings it's {price / eps_ttm:.1f}×")
+    v = _valuation(f, price)
+    if v.get("mcap"):
+        parts.append(f"market value {_money(v['mcap'])}")
+    rng = _range_line(m)
+    if rng:
+        parts.append(rng)
+    return "; ".join(parts) + "."
+
+
+_NUM_RE = re.compile(r"\d+(?:[.,]\d+)*")
+_NUM_WORDS = re.compile(
+    r"\b(two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|twenty|thirty|forty|"
+    r"fifty|sixty|seventy|eighty|ninety|hundred|thousand|million|billion|trillion|half|"
+    r"doubled?|tripled?|quadrupled?|halved)\b", re.IGNORECASE)
+
+
+def _numbers(text: str) -> set:
+    return ({n.replace(",", "") for n in _NUM_RE.findall(text or "")}
+            | {w.lower() for w in _NUM_WORDS.findall(text or "")})
+
+
+def news_summary_ok(summary: str, news: list) -> bool:
+    """Accept a model-written news summary only if it is short and every figure in it —
+    digits or number words — appears in the headlines/summaries it was written from.
+    Dates are deliberately NOT part of the source: their digits would admit invented
+    figures ("fell 24%" against a headline dated the 24th)."""
+    src = " ".join(f"{n.get('headline', '')} {n.get('summary', '')}" for n in news)
+    return 0 < len(summary) <= 400 and _numbers(summary) <= _numbers(src)
+
+
+def _json_object(raw: str | None) -> dict:
+    if not raw:
+        return {}
+    a, b = raw.find("{"), raw.rfind("}")
+    if a < 0 or b <= a:
+        return {}
+    try:
+        d = json.loads(raw[a:b + 1])
+    except ValueError:
+        return {}
+    return d if isinstance(d, dict) else {}
+
+
+def summarize_news(news_by_sym: dict) -> dict:
+    """{SYM: 1-2 sentence summary} written by GAI from each name's own headlines, one
+    call for all names. A summary that fails news_summary_ok is dropped (the report
+    then shows the latest headline instead)."""
+    items = {s: n for s, n in news_by_sym.items() if n}
+    if not items:
+        return {}
+    lines = ["Summarize the recent news for each stock ticker below in 1-2 plain-English sentences "
+             "for a busy CEO: what happened and why it matters for the stock. Use ONLY facts stated "
+             "in that ticker's own headlines and summaries; do not add numbers, dates, names or "
+             'opinions that are not in them. Reply with JSON only: {"TICKER": "summary", ...}', ""]
+    for s, n in items.items():
+        lines.append(f"{s}:")
+        lines += [f"- {x['headline']}. {str(x.get('summary') or '')[:300]}" for x in n]
+    got = _json_object(_gai("\n".join(lines)))
+    out: dict = {}
+    for s, n in items.items():
+        txt = got.get(s)
+        if isinstance(txt, str):
+            txt = " ".join(txt.split())
+            if news_summary_ok(txt, n):
+                out[s] = txt
+    return out
+
+
+def news_takeaway(news: list | None, summary: str | None) -> str:
+    if news is None:
+        return "News unavailable this run."
+    if not news:
+        return "No news in the last 3 weeks."
+    latest = str(news[0].get("created_at", ""))[:10]
+    if summary:
+        return f"{summary} (from {len(news)} headline{'s' if len(news) != 1 else ''}, latest {latest})"
+    return f"Latest headline ({latest}): {news[0]['headline']}."
+
+
+def name_lines(r: dict) -> list[str]:
+    """The three CEO takeaways for one name (candidate or hold)."""
+    val = valuation_takeaway(r["sym"], r.get("px"), r.get("fund") or {}, r.get("peer") or {},
+                             r.get("peer_year"), r.get("m") or {}, r.get("splits"))
+    return [f"  - Business: {fundamentals_takeaway(r.get('fund') or {}, (r.get('peer') or {}).get('sic', ''))}",
+            f"  - Valuation: {val}",
+            f"  - News: {news_takeaway(r.get('news'), r.get('news_sum'))}"]
+
+
+def _sp500_now() -> tuple[list[str], str | None]:
+    """(current S&P 500 tickers, list date YYYY-MM-DD) from the membership file (rows
+    with no end date). ([], None) if unavailable."""
+    try:
+        with _SP500_MEMBERS.open() as fh:
+            rows = list(csv.DictReader(fh))
+        asof = datetime.fromtimestamp(_SP500_MEMBERS.stat().st_mtime, PT).strftime("%Y-%m-%d")
+    except (OSError, csv.Error) as e:
+        logger.warning("S&P 500 membership unavailable (%s) — no peer comparison", e)
+        return [], None
+    return sorted({(r.get("ticker") or "").strip().upper() for r in rows
+                   if (r.get("ticker") or "").strip() and not (r.get("end") or "").strip()}), asof
+
+
+def enrich_valuation(rows: list[dict]) -> str:
+    """Set px (class-A price), peer, peer_year and splits on each row; return a one-line
+    note on the peer data for the methodology section. Fail-safe: when any source is
+    unavailable the peer comparison and the P/Es are left out and the report says so."""
+    for r in rows:
+        r.setdefault("px", (r.get("m") or {}).get("last"))
+        r["peer"], r["splits"] = {}, None
+    names = [_CLASS_A.get(r["sym"], r["sym"]) for r in rows]
+    try:
+        from data import alpaca_data
+        from data import edgar_client as ec
+        tickers, asof = _sp500_now()
+        members = sorted({_CLASS_A.get(t, t) for t in tickers})
+        if not members:
+            return "Peer comparison unavailable this run (no S&P 500 membership list)."
+        tick = ec.ticker_ciks()
+        ciks = {t: tick[t.replace(".", "-")] for t in set(members) | set(names)
+                if t.replace(".", "-") in tick}
+        today = datetime.now(ET).date()
+        year, frame = ec.latest_annual_eps(today, [ciks[t] for t in members if t in ciks])
+        sics = ec.sic_codes(sorted(set(ciks.values())))
+        sic = {t: sics[c] for t, c in ciks.items() if c in sics}
+        eps = {t: frame[c] for t, c in ciks.items() if c in frame}
+        fams = {sic[n][:3] for n in names if n in sic}
+        want = sorted(set(names) | {t for t in members if sic.get(t, "")[:3] in fams
+                                    and eps.get(t, 0) > 0})
+        price = alpaca_data.get_latest_trades(want)
+        since = min(date(year, 1, 1) if year else today, today - timedelta(days=460))
+        splits = alpaca_data.get_split_dates(want, since.isoformat(), today.isoformat())
+    except Exception as e:
+        logger.warning("peer valuation unavailable: %s", e)
+        return "Peer comparison unavailable this run (data error)."
+    if price is None or year is None or splits is None:
+        logger.warning("peer valuation unavailable: prices=%s year=%s splits=%s",
+                       price is not None, year, splits is not None)
+        return "Peer comparison unavailable this run (price, earnings or split data missing)."
+    # an annual EPS filed before a later split is on the old share count: withhold it
+    cutoff = f"{year + 1}-01-31"
+    withheld = frozenset(t for t, ds in splits.items() if any(d > cutoff for d in ds))
+    for r, n in zip(rows, names, strict=True):
+        if price.get(n):
+            r["px"] = price[n]
+        r["peer_year"] = year
+        r["splits"] = splits.get(n, [])
+        r["peer"] = peer_comp(n, sic, eps, price, members, withheld)
+    return (f"Peers: S&P 500 members as of {asof}, grouped by SEC industry code; P/E on {year} "
+            f"diluted EPS from SEC filings and the latest Alpaca price.")
+
+
+def news_lines(news: list | None) -> list[str]:
+    if news is None:
+        return ["  - News: unavailable this run"]
+    if not news:
+        return ["  - News: no headlines in the last 3 weeks"]
+    return [f"  - News {str(n.get('created_at', ''))[:10]} ({n.get('source') or '?'}): {n['headline']}"
+            for n in news]
+
+
