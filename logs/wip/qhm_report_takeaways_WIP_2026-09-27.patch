+
+class FundamentalsTakeaway(unittest.TestCase):
+    def test_strong(self):
+        t = qt.fundamentals_takeaway(F)
+        self.assertTrue(t.startswith("Strong: sales are growing (+18% from a year ago, $12.65B"))
+        self.assertIn("it is profitable ($9.50B net income over the last 12 months, 11% operating margin", t)
+        self.assertIn("earnings per share are up 35%", t)
+        self.assertIn("it generates cash ($8.10B free cash flow", t)
+        self.assertIn("quarter ended 2026-06-30", t)
+
+    def test_weak_and_mixed(self):
+        weak = {"revenue_yoy_pct": -12.0, "net_income_ttm": -3e8, "fcf_ttm": -1e8}
+        self.assertTrue(qt.fundamentals_takeaway(weak).startswith("Weak: sales are shrinking"))
+        mixed = {"revenue_yoy_pct": 2.0, "net_income_ttm": -3e8, "fcf_ttm": 5e8}
+        self.assertTrue(qt.fundamentals_takeaway(mixed).startswith("Mixed:"))
+        mostly = {"revenue_yoy_pct": 30.0, "net_income_ttm": 1e9, "fcf_ttm": -5e8}
+        self.assertTrue(qt.fundamentals_takeaway(mostly).startswith("Mostly healthy:"))
+
+    def test_lender_cash_flow_skipped_and_big_eps_caveat(self):
+        lender = qt.fundamentals_takeaway({**F, "fcf_ttm": -8.8e9}, sic="6199")
+        self.assertNotIn("cash", lender.split("net income")[1])
+        self.assertTrue(lender.startswith("Strong:"))  # judged on growth + profit only
+        self.assertIn("burning cash", qt.fundamentals_takeaway({**F, "fcf_ttm": -8.8e9}, sic="7389"))
+        big = qt.fundamentals_takeaway({**F, "eps_yoy_pct": 294.0})
+        self.assertIn("up 294% from a year ago — a jump that large usually includes one-time items", big)
+        self.assertNotIn("one-time", qt.fundamentals_takeaway(F))
+
+    def test_small_eps_change_not_mentioned_and_empty(self):
+        self.assertNotIn("per share", qt.fundamentals_takeaway({**F, "eps_yoy_pct": 4.0}))
+        self.assertIn("No SEC filing data", qt.fundamentals_takeaway({}))
+        self.assertIn("don't report enough", qt.fundamentals_takeaway({"period_end": "x"}))
+
+
+SIC = {"UBER": "7389", "V": "7389", "MA": "7389", "PYPL": "7389", "ACN": "7380",
+       "GOOGL": "7370", "META": "7370", "MSFT": "7372", "ORCL": "7372"}
+EPS = {"UBER": 4.73, "V": 10.0, "MA": 15.0, "PYPL": 4.0, "ACN": 12.0,
+       "GOOGL": 10.81, "META": 25.0, "MSFT": 13.0, "ORCL": -1.0}
+PX = {"UBER": 69.60, "V": 300.0, "MA": 540.0, "PYPL": 60.0, "ACN": 240.0,
+      "GOOGL": 343.85, "META": 700.0, "MSFT": 500.0, "ORCL": 200.0}
+MEMBERS = sorted(SIC) + ["GOOG"]
+
+
+class PeerComp(unittest.TestCase):
+    def test_same_four_digit_industry(self):
+        p = qt.peer_comp("UBER", SIC, EPS, PX, MEMBERS)
+        self.assertEqual(p["digits"], 4)
+        self.assertEqual([t for t, _ in p["peers"]], ["PYPL", "V", "MA"])  # 15, 30, 36
+        self.assertAlmostEqual(p["median"], 30.0)
+        self.assertAlmostEqual(p["pe"], 69.60 / 4.73)
+        self.assertLess(p["vs_peers_pct"], -20)
+
+    def test_widens_to_three_digits_only(self):
+        # GOOGL: 7370 has only META at 4 digits -> 3 digits (737x): META, MSFT (ORCL has a
+        # loss) -> still < 3 -> never widens to 2 digits (unrelated businesses): no peers.
+        p = qt.peer_comp("GOOG", SIC, EPS, PX, MEMBERS)
+        self.assertEqual(p["peers"], [])
+        self.assertEqual(p["status"], "ok")
+        sic = dict(SIC, NOW="7372")
+        p = qt.peer_comp("GOOG", sic, dict(EPS, NOW=5.0), dict(PX, NOW=800.0), MEMBERS + ["NOW"])
+        self.assertEqual(p["digits"], 3)
+        names = [t for t, _ in p["peers"]]
+        self.assertEqual(sorted(names), ["META", "MSFT", "NOW"])
+        self.assertNotIn("GOOGL", names)   # its own other-class listing is not its peer
+        self.assertAlmostEqual(p["pe"], 343.85 / 10.81)  # class-A price
+
+    def test_split_withheld_and_status(self):
+        p = qt.peer_comp("UBER", SIC, EPS, PX, MEMBERS, frozenset({"V"}))
+        self.assertNotIn("V", [t for t, _ in p["peers"]])
+        own = qt.peer_comp("UBER", SIC, EPS, PX, MEMBERS + ["X1"], frozenset({"UBER"}))
+        self.assertEqual(own["status"], "split")
+        self.assertNotIn("pe", own)
+        nop = qt.peer_comp("UBER", SIC, EPS, {k: v for k, v in PX.items() if k != "UBER"}, MEMBERS)
+        self.assertEqual(nop["status"], "no_price")
+
+    def test_no_industry_or_too_few_peers(self):
+        self.assertEqual(qt.peer_comp("ZZZ", SIC, EPS, PX, MEMBERS), {})
+        self.assertEqual(qt.peer_comp("UBER", {"UBER": "73"}, EPS, PX, MEMBERS), {})
+        lone = qt.peer_comp("UBER", {"UBER": "9999", "V": "1000"}, EPS, PX, ["UBER", "V"])
+        self.assertEqual(lone["peers"], [])
+        self.assertNotIn("median", lone)
+
+    def test_loss_maker_has_no_pe(self):
+        p = qt.peer_comp("ORCL", SIC, EPS, PX, MEMBERS)
+        self.assertNotIn("pe", p)
+        self.assertEqual(p["status"], "loss")
+
+
+class ValuationTakeaway(unittest.TestCase):
+    M = {"last": 69.60, "high52": 97.71, "low52": 59.33}
+
+    def test_cheap_vs_peers_line(self):
+        peer = qt.peer_comp("UBER", SIC, EPS, PX, MEMBERS)
+        t = qt.valuation_takeaway("UBER", 69.60, {**F, "eps_fy_end": "2025-12-31"}, peer, 2025, self.M, [])
+        self.assertTrue(t.startswith("Cheap vs peers: at $69.60 it trades at 14.7× its 2025 earnings"))
+        self.assertIn("median 30.0× for 3 S&P 500 peers in the same SEC industry (PYPL, V, MA)", t)
+        self.assertIn("51% below them", t)
+        self.assertIn("on the last 12 months of earnings it's 15.3×", t)
+        self.assertIn("29% below its 52-week high ($97.71) and 17% above its low ($59.33)", t)
+
+    def test_ttm_withheld_on_split_or_unknown_splits(self):
+        peer = qt.peer_comp("UBER", SIC, EPS, PX, MEMBERS)
+        f = {**F, "eps_fy_end": "2025-12-31"}
+        ok = qt.valuation_takeaway("UBER", 69.60, f, peer, 2025, self.M, ["2025-06-01"])
+        self.assertIn("last 12 months", ok)                # split before the fiscal year end
+        after = qt.valuation_takeaway("UBER", 69.60, f, peer, 2025, self.M, ["2026-03-02"])
+        self.assertNotIn("last 12 months", after)          # split after it: withheld
+        self.assertNotIn("last 12 months", qt.valuation_takeaway("UBER", 69.60, f, peer, 2025, self.M, None))
+
+    def test_range_line_direction_and_basis(self):
+        self.assertIn("at its 52-week high ($99.00)", qt._range_line({"last": 100.0, "high52": 99.0, "low52": 50.0}))
+        self.assertIn("50% below its 52-week high ($200.00) and 100% above its low ($50.00)",
+                      qt._range_line({"last": 100.0, "high52": 200.0, "low52": 50.0}))
+        # uses the bars' own close, never the (possibly other-class) price argument
+        t = qt.valuation_takeaway("BRK.B", 700000.0, {}, {}, 2025, {"last": 480.0, "high52": 500.0, "low52": 400.0}, [])
+        self.assertIn("4% below its 52-week high ($500.00)", t)
+
+    def test_class_a_label_and_expensive(self):
+        peer = {"peers": [("A", 10.0), ("B", 12.0), ("C", 14.0)], "median": 12.0,
+                "pe": 20.0, "vs_peers_pct": 66.7, "eps": 1.0}
+        t = qt.valuation_takeaway("GOOG", 343.85, {}, peer, 2025, {})
+        self.assertTrue(t.startswith("Expensive vs peers: at $343.85 (class A, GOOGL)"))
+
+    def test_about_the_same(self):
+        peer = {"peers": [("A", 10.0), ("B", 12.0), ("C", 14.0)], "median": 12.0,
+                "pe": 12.05, "vs_peers_pct": 0.4, "eps": 1.0}
+        self.assertIn("— about the same as them", qt.valuation_takeaway("X", 12.05, {}, peer, 2025, {}))
+
+    def test_fallback_wordings(self):
+        base = {"peers": [("A", 10.0), ("B", 12.0), ("C", 14.0)], "median": 12.0, "digits": 4}
+        for status, text in (("loss", "No P/E: it lost money in 2025"),
+                             ("split", "No P/E: a stock split since its 2025 results"),
+                             ("no_price", "No P/E: no current price was available this run"),
+                             ("no_eps", "No P/E: its SEC data has no 2025 diluted earnings per share")):
+            self.assertTrue(qt.valuation_takeaway("X", 5.0, {}, dict(base, status=status), 2025, {}).startswith(text), status)
+        few = {"sic": "9999", "peers": []}
+        self.assertIn("fewer than 3", qt.valuation_takeaway("X", 5.0, {}, few, 2025, {}))
+        self.assertIn("No peer comparison available", qt.valuation_takeaway("X", 5.0, {}, {}, None, {}))
+
+
+NEWS = [{"headline": "Uber raises 2026 bookings outlook to $190 billion", "summary": "",
+         "created_at": "2026-09-24T12:00:00Z"},
+        {"headline": "Uber expands robotaxi deal", "summary": "Adds 3 cities",
+         "created_at": "2026-09-20T12:00:00Z"}]
