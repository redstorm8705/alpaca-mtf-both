diff --git a/data/alpaca_data.py b/data/alpaca_data.py
index 25af52e..0160206 100644
--- a/data/alpaca_data.py
+++ b/data/alpaca_data.py
@@ -203,3 +203,129 @@ def get_name_changes(start: str, end: str, symbols: list | None = None) -> list
     except Exception as e:
         logger.warning("get_name_changes failed: %s", e)
         return None
+
+
+_NEWS_TIMEOUT = 15.0  # seconds — research/report use, not on the trading path
+
+
+def get_news(symbol: str, days: int = 30, limit: int = 5) -> list | None:
+    """Recent news headlines for one symbol from Alpaca's news API (T1, same key).
+
+    Endpoint: GET /v1beta1/news?symbols=&start=&limit=&sort=desc
+    Returns up to `limit` dicts {headline, summary, source, created_at (UTC ISO)},
+    newest first, or None on any failure (so a caller can say "news unavailable"
+    rather than "no news"). Used by the QHM research report; no trading-path caller.
+    """
+    from datetime import datetime, timedelta, timezone
+
+    start = (datetime.now(timezone.utc) - timedelta(days=days)).strftime(
+        "%Y-%m-%dT%H:%M:%SZ")
+    params = {"symbols": symbol, "start": start, "limit": max(1, min(int(limit), 50)),
+              "sort": "desc", "include_content": "false"}
+    try:
+        resp = None
+        for _attempt in range(3):
+            resp = requests.get(f"{_BASE}/v1beta1/news", params=params,
+                                headers=_headers(), timeout=_NEWS_TIMEOUT)
+            if resp.status_code != 429:
+                break
+            time.sleep(2 ** _attempt)
+        if resp is None or resp.status_code != 200:
+            logger.warning("get_news(%s): HTTP %s", symbol,
+                           getattr(resp, "status_code", None))
+            return None
+        out: list = []
+        for n in (resp.json().get("news") or [])[:limit]:
+            head = str(n.get("headline") or "").strip()
+            if not head:
+                continue
+            out.append({"headline": head,
+                        "summary": str(n.get("summary") or "").strip(),
+                        "source": str(n.get("source") or "").strip(),
+                        "created_at": str(n.get("created_at") or "")})
+        return out
+    except Exception as e:
+        logger.warning("get_news(%s) failed: %s", symbol, e)
+        return None
+
+
+def get_latest_trades(symbols: list) -> dict | None:
+    """Latest trade price for many symbols in one request per 100 (T1).
+
+    Endpoint: GET /v2/stocks/trades/latest?symbols=
+    Returns {SYMBOL: price} (symbols with no trade are simply absent), or None on
+    ANY failure so a caller cannot mistake a failed lookup for "no prices". Used by
+    the QHM research report (peer valuation); no trading-path caller.
+    """
+    syms = [str(s).upper() for s in dict.fromkeys(symbols) if s]
+    out: dict = {}
+    try:
+        for i in range(0, len(syms), 100):
+            resp = None
+            for _attempt in range(3):
+                resp = requests.get(f"{_BASE}/v2/stocks/trades/latest",
+                                    params={"symbols": ",".join(syms[i:i + 100])},
+                                    headers=_headers(), timeout=_NEWS_TIMEOUT)
+                if resp.status_code != 429:
+                    break
+                time.sleep(2 ** _attempt)
+            if resp is None or resp.status_code != 200:
+                logger.warning("get_latest_trades: HTTP %s",
+                               getattr(resp, "status_code", None))
+                return None
+            for sym, t in (resp.json().get("trades") or {}).items():
+                p = t.get("p") if isinstance(t, dict) else None
+                if isinstance(p, (int, float)) and p > 0:
+                    out[str(sym).upper()] = float(p)
+        return out
+    except Exception as e:
+        logger.warning("get_latest_trades failed: %s", e)
+        return None
+
+
+def get_split_dates(symbols: list, start: str, end: str) -> dict | None:
+    """Stock split dates (forward and reverse) per symbol from Alpaca corporate
+    actions (T1). Returns {SYMBOL: [YYYY-MM-DD, ...]} (symbols without a split are
+    absent), or None on ANY failure so a caller never mistakes a failed lookup for
+    "no splits". Used by the QHM research report to withhold a P/E whose earnings
+    per share may predate a split; no trading-path caller.
+    """
+    syms = [str(s).upper() for s in dict.fromkeys(symbols) if s]
+    out: dict = {}
+    try:
+        for i in range(0, len(syms), 50):
+            params: dict = {"types": "forward_split,reverse_split",
+                            "symbols": ",".join(syms[i:i + 50]),
+                            "start": start, "end": end, "limit": _CA_PAGE_LIMIT}
+            for _page in range(_CA_MAX_PAGES):
+                resp = None
+                for _attempt in range(3):
+                    resp = requests.get(f"{_BASE}/v1/corporate-actions", params=params,
+                                        headers=_headers(), timeout=_CA_TIMEOUT)
+                    if resp.status_code != 429:
+                        break
+                    time.sleep(2 ** _attempt)
+                if resp is None or resp.status_code != 200:
+                    logger.warning("get_split_dates: HTTP %s",
+                                   getattr(resp, "status_code", None))
+                    return None
+                body = resp.json()
+                ca = body.get("corporate_actions") or {}
+                for kind in ("forward_splits", "reverse_splits"):
+                    for s in ca.get(kind) or []:
+                        sym = s.get("symbol")
+                        when = s.get("ex_date") or s.get("process_date")
+                        if sym and when:
+                            out.setdefault(str(sym).upper(), []).append(str(when)[:10])
+                token = body.get("next_page_token")
+                if not token:
+                    break
+                params["page_token"] = token
+            else:
+                logger.warning("get_split_dates: more than %d pages — returning None",
+                               _CA_MAX_PAGES)
+                return None
+        return out
+    except Exception as e:
+        logger.warning("get_split_dates failed: %s", e)
+        return None
diff --git a/data/edgar_client.py b/data/edgar_client.py
new file mode 100644
index 0000000..2d3d656
--- /dev/null
+++ b/data/edgar_client.py
@@ -0,0 +1,488 @@
+"""
+data/edgar_client.py
+SEC EDGAR XBRL client: reported company fundamentals from the companies' own
+10-Q/10-K filings (data.sec.gov companyfacts).
+
+Data tier: T2 (fundamentals). Board data seats (McKinney / Katsuyama / Harris) and
+GAI approved it 2026-09-27 for research use (the QHM thesis memo, the Confluence
+2.0 lab); the live trading path never calls it. FMP's free plan returns "premium"
+for these statements.
+
+SEC rules: a descriptive User-Agent with a contact email (EDGAR_CONTACT_EMAIL in
+.env, never hard-coded; no email -> no request, None returned) and at most 10
+requests/second. Cache: data/cache/edgar/ JSON files, 7-day TTL (filings change
+quarterly), atomic writes.
+
+Figures are REPORTED values. A missing concept returns None and the report shows
+"not reported", never an estimate. Quarterly filings report cash flows
+year-to-date and Q4 is rarely reported on its own, so quarter and trailing-12-month
+values are derived from the filed periods (quarter_value / ttm_value). Amended
+filings: for a given period the most recently filed value wins.
+"""
+
+import json
+import logging
+import os
+import time
+import urllib.request
+from datetime import date, timedelta
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+
+_FACTS_URL = "https://data.sec.gov/api/xbrl/companyfacts/CIK{cik:010d}.json"
+_TICKERS_URL = "https://www.sec.gov/files/company_tickers.json"
+_SUBMISSIONS_URL = "https://data.sec.gov/submissions/CIK{cik:010d}.json"
+# Every filer's diluted EPS for one calendar-aligned fiscal year, in one request.
+_EPS_FRAME_URL = (
+    "https://data.sec.gov/api/xbrl/frames/us-gaap/EarningsPerShareDiluted/"
+    "USD-per-shares/CY{year}.json"
+)
+_CACHE_DIR = Path(__file__).resolve().parent.parent / "data" / "cache" / "edgar"
+_TTL_S = 7 * 24 * 3600
+_SIC_TTL_S = 30 * 24 * 3600  # industry codes rarely change
+_SIC_MAP = _CACHE_DIR / "sic_map.json"
+_FRAME_MIN_FILERS = 1000  # a year still being filed has only a partial frame
+_MIN_GAP_S = 0.15  # SEC allows 10 req/s; stay well under
+_TIMEOUT = 20.0
+_last_req = 0.0
+
+# Concept fallbacks (XBRL tags vary by filer and changed with ASC 606 ~2018).
+CONCEPTS = {
+    "revenue": [
+        "RevenuesNetOfInterestExpense",  # banks / lenders: total net revenue
+        "RevenueFromContractWithCustomerExcludingAssessedTax",
+        "Revenues",
+        "SalesRevenueNet",
+        "RevenueFromContractWithCustomerIncludingAssessedTax",
+    ],
+    "gross_profit": ["GrossProfit"],
+    "operating_income": ["OperatingIncomeLoss"],
+    "net_income": [
+        "NetIncomeLoss",
+        "ProfitLoss",
+        "NetIncomeLossAvailableToCommonStockholdersBasic",
+    ],
+    "eps_diluted": ["EarningsPerShareDiluted"],
+    "op_cash_flow": [
+        "NetCashProvidedByUsedInOperatingActivities",
+        "NetCashProvidedByUsedInOperatingActivitiesContinuingOperations",
+    ],
+    "capex": [
+        "PaymentsToAcquirePropertyPlantAndEquipment",
+        "PaymentsToAcquireProductiveAssets",
+    ],
+}
+
+
+def _user_agent() -> str | None:
+    email = os.getenv("EDGAR_CONTACT_EMAIL", "").strip()
+    return f"alpaca-mtf-bot research {email}" if email else None
+
+
+def _get_json(url: str, cache_name: str | None) -> dict | list | None:
+    """Cached GET. Fresh cache (<7 days) is returned without a request; otherwise one
+    paced request with the SEC User-Agent. cache_name None = do not cache the raw
+    response. None on any failure or without a contact."""
+    global _last_req
+    path = _CACHE_DIR / cache_name if cache_name else None
+    try:
+        if path and path.exists() and time.time() - path.stat().st_mtime < _TTL_S:
+            return json.loads(path.read_text())
+    except (OSError, ValueError) as e:
+        logger.warning("edgar cache read failed (%s): %s", cache_name, e)
+    ua = _user_agent()
+    if not ua:
+        logger.warning(
+            "EDGAR_CONTACT_EMAIL not set — SEC request skipped (%s)", cache_name
+        )
+        return None
+    wait = _MIN_GAP_S - (time.monotonic() - _last_req)
+    if wait > 0:
+        time.sleep(wait)
+    _last_req = time.monotonic()
+    try:
+        req = urllib.request.Request(
+            url, headers={"User-Agent": ua, "Accept-Encoding": "identity"}
+        )
+        with urllib.request.urlopen(req, timeout=_TIMEOUT) as r:
+            raw = r.read()
+        data = json.loads(raw.decode())
+    except Exception as e:
+        logger.warning("edgar fetch failed (%s): %s", url, e)
+        return None
+    if path is None:
+        return data
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        tmp = path.with_suffix(".tmp")
+        tmp.write_bytes(raw)
+        tmp.replace(path)
+    except OSError as e:
+        logger.warning("edgar cache write failed (%s): %s", cache_name, e)
+    return data
+
+
+def ticker_ciks() -> dict:
+    """{TICKER: CIK} for every SEC-listed ticker, in SEC's spelling ('BRK-B').
+    {} when unavailable."""
+    data = _get_json(_TICKERS_URL, "company_tickers.json")
+    out: dict = {}
+    if not isinstance(data, dict):
+        return out
+    for row in data.values():
+        if not isinstance(row, dict):
+            continue
+        try:
+            out.setdefault(str(row["ticker"]).upper(), int(row["cik_str"]))
+        except (KeyError, TypeError, ValueError):
+            continue
+    return out
+
+
+def cik_for(ticker: str) -> int | None:
+    """SEC CIK for a ticker ('BRK.B' -> SEC's 'BRK-B'). None if unknown."""
+    return ticker_ciks().get(ticker.strip().upper().replace(".", "-"))
+
+
+def sic_codes(ciks: list) -> dict:
+    """{CIK: 4-digit SEC industry (SIC) code} from each filer's submissions record.
+    Only the code is kept (data/cache/edgar/sic_map.json, 30-day TTL, atomic write);
+    a failed lookup is not cached and the CIK is simply absent from the result."""
+    try:
+        cache = json.loads(_SIC_MAP.read_text()) if _SIC_MAP.exists() else {}
+        if not isinstance(cache, dict):
+            cache = {}
+    except (OSError, ValueError) as e:
+        logger.warning("edgar sic cache read failed: %s", e)
+        cache = {}
+    now = time.time()
+    out: dict = {}
+    changed = False
+    for cik in ciks:
+        ent = cache.get(str(cik))
+        if isinstance(ent, dict) and now - float(ent.get("t", 0)) < _SIC_TTL_S:
+            if ent.get("sic"):
+                out[cik] = str(ent["sic"])
+            continue
+        data = _get_json(_SUBMISSIONS_URL.format(cik=int(cik)), None)
+        if not isinstance(data, dict):
+            continue
+        sic = str(data.get("sic") or "").strip()
+        cache[str(cik)] = {"sic": sic, "t": now}
+        changed = True
+        if sic:
+            out[cik] = sic
+    if changed:
+        try:
+            _SIC_MAP.parent.mkdir(parents=True, exist_ok=True)
+            tmp = _SIC_MAP.with_suffix(".tmp")
+            tmp.write_text(json.dumps(cache))
+            tmp.replace(_SIC_MAP)
+        except OSError as e:
+            logger.warning("edgar sic cache write failed: %s", e)
+    return out
+
+
+def annual_eps(year: int) -> dict:
+    """{CIK: diluted EPS} for every filer's fiscal year aligned to calendar `year`
+    (SEC frames). {} when unavailable."""
+    data = _get_json(_EPS_FRAME_URL.format(year=year), f"frame_eps_CY{year}.json")
+    out: dict = {}
+    rows = data.get("data") if isinstance(data, dict) else None
+    for r in rows or []:
+        try:
+            out[int(r["cik"])] = float(r["val"])
+        except (KeyError, TypeError, ValueError):
+            continue
+    return out
+
+
+def latest_annual_eps(today: date, ciks: list | None = None,
+                      min_coverage: float = 0.8) -> tuple:
+    """(year, {CIK: diluted EPS}) for the most recent calendar year whose frame is
+    substantially filed; (None, {}) otherwise. With `ciks` (e.g. the S&P 500), the
+    frame must cover at least `min_coverage` of them; without, at least
+    _FRAME_MIN_FILERS companies."""
+    for year in (today.year - 1, today.year - 2):
+        m = annual_eps(year)
+        if ciks:
+            ok = sum(1 for c in ciks if c in m) >= min_coverage * len(ciks)
+        else:
+            ok = len(m) >= _FRAME_MIN_FILERS
+        if ok:
+            return year, m
+    return None, {}
+
+
+def company_facts(ticker: str) -> dict | None:
+    cik = cik_for(ticker)
+    if cik is None:
+        return None
+    data = _get_json(_FACTS_URL.format(cik=cik), f"facts_{cik:010d}.json")
+    return data if isinstance(data, dict) else None
+
+
+# ── pure period math (unit-tested) ──────────────────────────────────────────────────
+
+
+def _d(s: str) -> date:
+    return date.fromisoformat(s)
+
+
+def rows_for(facts: dict, key: str) -> list[dict]:
+    """Deduplicated filed rows {start, end, val, filed} for the first concept in
+    CONCEPTS[key] that has data (preferring the concept whose data is most recent).
+    For the same (start, end) period the most recently filed value wins (amendments)."""
+    gaap = (facts or {}).get("facts", {}).get("us-gaap", {})
+    best: list[dict] = []
+    best_end = ""
+    for concept in CONCEPTS.get(key, []):
+        units = gaap.get(concept, {}).get("units", {})
+        vals = units.get("USD") or units.get("USD/shares") or []
+        by_period: dict = {}
+        for r in vals:
+            if r.get("form") not in ("10-Q", "10-K", "10-Q/A", "10-K/A"):
+                continue
+            if "end" not in r or "val" not in r:
+                continue
+            k = (r.get("start"), r["end"])
+            if k not in by_period or str(r.get("filed", "")) > str(
+                by_period[k].get("filed", "")
+            ):
+                by_period[k] = r
+        rows = sorted(
+            by_period.values(), key=lambda r: (r["end"], r.get("start") or "")
+        )
+        last = rows[-1]["end"] if rows else ""
+        if last > best_end:
+            best, best_end = rows, last
+        elif key == "revenue" and rows and last == best_end and best:
+            # Several revenue tags for the same latest period (e.g. a bank files
+            # contract revenue as one component of total revenue): keep the total,
+            # i.e. the larger latest-quarter-scale value.
+            ref = (best[-1].get("start"), best[-1]["end"])
+            mine = next((r for r in rows if (r.get("start"), r["end"]) == ref), None)
+            if mine is not None and abs(float(mine["val"])) > abs(
+                float(best[-1]["val"])
+            ):
+                best = rows
+    return best
+
+
+def _days(r: dict) -> int | None:
+    if not r.get("start"):
+        return None
+    return (_d(r["end"]) - _d(r["start"])).days
+
+
+def _near(a: date, b: date, tol: int = 10) -> bool:
+    return abs((a - b).days) <= tol
+
+
+def quarter_value(rows: list[dict], end: str) -> float | None:
+    """The 3-month value for the quarter ending `end`: a reported ~quarter-length row,
+    else derived as YTD(end) − YTD(prior quarter end) with the same start (this is how
+    Q4 = FY − 9 months and year-to-date cash flows become quarters)."""
+    e = _d(end)
+    for r in rows:
+        dd = _days(r)
+        if r["end"] == end and dd is not None and 80 <= dd <= 100:
+            return float(r["val"])
+    ytd = [r for r in rows if r["end"] == end and (_days(r) or 0) > 100]
+    for cur in sorted(ytd, key=lambda r: -(_days(r) or 0)):
+        prev_end = e - timedelta(days=91)
+        for p in rows:
+            if (
+                p.get("start") == cur.get("start")
+                and p["end"] != end
+                and _near(_d(p["end"]), prev_end, 12)
+            ):
+                return float(cur["val"]) - float(p["val"])
+    # Q4 from a full-year row minus three reported quarters of the same fiscal year.
+    for fy in ytd:
+        dd = _days(fy)
+        if dd is None or not 350 <= dd <= 380:
+            continue
+        s0 = _d(fy["start"])
+        qs = [
+            r
+            for r in rows
+            if r.get("start")
+            and 80 <= (_days(r) or 0) <= 100
+            and s0 <= _d(r["start"])
+            and _d(r["end"]) < e
+        ]
+        if len(qs) == 3:
+            return float(fy["val"]) - sum(float(r["val"]) for r in qs)
+    return None
+
+
+def reported_quarter(rows: list[dict], end: str) -> float | None:
+    """A quarter value only when filed as a ~3-month row (no derivation). Used for
+    per-share figures, which are not additive across periods (share counts change)."""
+    for r in rows:
+        dd = _days(r)
+        if r["end"] == end and dd is not None and 80 <= dd <= 100:
+            return float(r["val"])
+    return None
+
+
+def ttm_value(rows: list[dict], end: str) -> float | None:
+    """Trailing-12-month value ending `end`: a reported ~annual row; else last full
+    fiscal year + current YTD − prior-year same YTD; else the sum of four quarters."""
+    e = _d(end)
+    for r in rows:
+        dd = _days(r)
+        if r["end"] == end and dd is not None and 350 <= dd <= 380:
+            return float(r["val"])
+    cur = max(
+        (r for r in rows if r["end"] == end and r.get("start")),
+        key=lambda r: _days(r) or 0,
+        default=None,
+    )
+    if cur is not None:
+        s = _d(cur["start"])
+        fy = next(
+            (
+                r
+                for r in rows
+                if r.get("start")
+                and _near(_d(r["end"]), s - timedelta(days=1), 5)
+                and 350 <= (_days(r) or 0) <= 380
+            ),
+            None,
+        )
+        prior = next(
+            (
+                r
+                for r in rows
+                if r.get("start")
+                and _near(_d(r["end"]), e - timedelta(days=365), 10)
+                and _near(_d(r["start"]), s - timedelta(days=365), 10)
+            ),
+            None,
+        )
+        if fy is not None and prior is not None:
+            return float(fy["val"]) + float(cur["val"]) - float(prior["val"])
+    total = 0.0
+    q_end = e
+    ends = sorted({r["end"] for r in rows}, reverse=True)
+    for _ in range(4):
+        match = next((x for x in ends if _near(_d(x), q_end, 10)), None)
+        if match is None:
+            return None
+        v = quarter_value(rows, match)
+        if v is None:
+            return None
+        total += v
+        q_end = _d(match) - timedelta(days=91)
+    return total
+
+
+def _year_ago_end(rows: list[dict], end: str) -> str | None:
+    target = _d(end) - timedelta(days=365)
+    return next((r["end"] for r in rows if _near(_d(r["end"]), target, 10)), None)
+
+
+def summarize(facts: dict) -> dict:
+    """Reported fundamentals for the latest filed quarter. Missing items are None."""
+    out: dict = {}
+    rev = rows_for(facts, "revenue")
+    if not rev and not rows_for(facts, "net_income"):
+        return out
+    ni_rows = rows_for(facts, "net_income")
+    anchor = (
+        rev
+        if (rev and (not ni_rows or rev[-1]["end"] >= ni_rows[-1]["end"]))
+        else ni_rows
+    )
+    end = anchor[-1]["end"]
+    out["period_end"] = end
+    out["filed"] = max(
+        (str(r.get("filed", "")) for r in anchor if r["end"] == end), default=""
+    )
+    series = {k: rows_for(facts, k) for k in CONCEPTS}
+    q = {
+        k: quarter_value(v, end) if v else None
+        for k, v in series.items()
+        if k != "eps_diluted"  # per-share: only reported quarters (below)
+    }
+    t = {
+        k: ttm_value(v, end) if v else None
+        for k, v in series.items()
+        if k != "eps_diluted"
+    }
+    ago = _year_ago_end(rev, end) if rev else None
+    rev_ago = quarter_value(rev, ago) if (rev and ago) else None
+    eps_rows = series["eps_diluted"]
+    eps_ago_end = _year_ago_end(eps_rows, end) if eps_rows else None
+    eps_ago = reported_quarter(eps_rows, eps_ago_end) if eps_ago_end else None
+    eps_q = reported_quarter(eps_rows, end) if eps_rows else None
+    # Trailing-12-month diluted EPS: the filed annual figure, else the filed periods
+    # combined the same way as the other TTM figures (the usual TTM-EPS convention).
+    eps_ttm = ttm_value(eps_rows, end) if eps_rows else None
+    # End of the latest full fiscal year with a filed EPS: a split after it means the
+    # annual figure inside eps_ttm may still be on the pre-split share count.
+    fy_end = max(
+        (r["end"] for r in eps_rows if 350 <= (_days(r) or 0) <= 380), default=None
+    )
+    out.update(
+        {
+            "revenue_q": q["revenue"],
+            "revenue_ttm": t["revenue"],
+            "revenue_yoy_pct": _pct(q["revenue"], rev_ago),
+            "gross_margin_pct": _ratio(q["gross_profit"], q["revenue"]),
+            "op_margin_pct": _ratio(q["operating_income"], q["revenue"]),
+            "net_income_q": q["net_income"],
+            "net_income_ttm": t["net_income"],
+            "eps_q": eps_q,
+            "eps_yoy_pct": _pct(eps_q, eps_ago),
+            "eps_ttm": eps_ttm,
+            "eps_fy_end": fy_end,
+            "op_cash_flow_ttm": t["op_cash_flow"],
+            "capex_ttm": t["capex"],
+        }
+    )
+    if t["op_cash_flow"] is not None and t["capex"] is not None:
+        out["fcf_ttm"] = t["op_cash_flow"] - t["capex"]
+    shares = (
+        facts.get("facts", {})
+        .get("dei", {})
+        .get("EntityCommonStockSharesOutstanding", {})
+        .get("units", {})
+        .get("shares", [])
+    )
+    if shares:
+        # A single, current company-wide count only. Multi-class issuers file one row
+        # per class (classes can differ in economics, e.g. Berkshire A vs B), and some
+        # filers' dei counts are years stale: in either case leave shares_out unset so
+        # the report says valuation is not available rather than showing a wrong one.
+        latest = max(shares, key=lambda r: (r.get("end", ""), str(r.get("filed", ""))))
+        same = [
+            r
+            for r in shares
+            if r.get("end") == latest.get("end") and r.get("accn") == latest.get("accn")
+        ]
+        fresh = abs((_d(latest["end"]) - _d(end)).days) <= 200
+        if len(same) == 1 and fresh:
+            out["shares_out"] = float(latest["val"])
+    return out
+
+
+def _pct(cur: float | None, ago: float | None) -> float | None:
+    if cur is None or ago is None or ago == 0:
+        return None
+    return round((cur / ago - 1.0) * 100.0 * (1 if ago > 0 else -1), 1)
+
+
+def _ratio(num: float | None, den: float | None) -> float | None:
+    if num is None or den is None or den == 0:
+        return None
+    return round(num / den * 100.0, 1)
+
+
+def fundamentals(ticker: str) -> dict:
+    """summarize(company_facts(ticker)); {} when unavailable."""
+    facts = company_facts(ticker)
+    return summarize(facts) if facts else {}
