+
+class MemoUsesTakeaways(unittest.TestCase):
+    def test_memo_sections(self):
+        r = {"sym": "UBER", "m": {"last": 69.6}, "fund": F, "news": NEWS, "news_sum": "S.",
+             "px": 69.6, "peer": qt.peer_comp("UBER", SIC, EPS, PX, MEMBERS), "peer_year": 2025}
+        with mock.patch.object(qt, "_pending_approvals", return_value=[]):
+            memo = qt.build_memo("2026-09-27", [r], [dict(r, pos=None)], 2541.0, None, None, {})
