+
+class NewsSummary(unittest.TestCase):
+    def test_validator(self):
+        self.assertTrue(qt.news_summary_ok("Uber raised its 2026 bookings outlook to $190 billion and added 3 robotaxi cities.", NEWS))
+        self.assertFalse(qt.news_summary_ok("Uber stock rose 12% on the news.", NEWS))  # 12 not in source
+        self.assertFalse(qt.news_summary_ok("Uber shares fell 24% after the deal.", NEWS))  # date digits don't count
+        self.assertFalse(qt.news_summary_ok("Uber shares doubled.", NEWS))
+        self.assertFalse(qt.news_summary_ok("Bookings rose forty percent.", NEWS))
+        self.assertFalse(qt.news_summary_ok("", NEWS))
+        self.assertFalse(qt.news_summary_ok("x" * 401, NEWS))
+
+    def test_summarize_keeps_valid_drops_invented(self):
+        reply = '```json\n{"UBER": "Uber lifted its 2026 outlook and expanded robotaxis.", "SOFI": "SoFi jumped 40%."}\n```'
+        with mock.patch.object(qt, "_gai", return_value=reply) as g:
+            out = qt.summarize_news({"UBER": NEWS, "SOFI": [{"headline": "SoFi news", "created_at": ""}], "NFLX": [], "X": None})
+        self.assertEqual(out, {"UBER": "Uber lifted its 2026 outlook and expanded robotaxis."})
+        self.assertEqual(g.call_count, 1)
+        with mock.patch.object(qt, "_gai", return_value=None):
