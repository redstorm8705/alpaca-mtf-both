+
+_ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(_ROOT))
+sys.path.insert(0, str(_ROOT / "scripts"))
+
+import qhm_thesis as qt  # noqa: E402
+from data import alpaca_data  # noqa: E402
+from data import edgar_client as ec  # noqa: E402
+
+F = {
+    "period_end": "2026-06-30",
+    "revenue_q": 12.65e9,
+    "revenue_yoy_pct": 18.2,
+    "net_income_ttm": 9.5e9,
+    "op_margin_pct": 11.4,
+    "eps_yoy_pct": 35.0,
+    "fcf_ttm": 8.1e9,
+    "eps_ttm": 4.56,
+}
