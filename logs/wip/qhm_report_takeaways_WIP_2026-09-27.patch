+"""data/edgar_client.py — period math, concept choice, share count, no-contact guard.
+No network: synthetic companyfacts."""
+
+import sys
+import unittest
+from pathlib import Path
+from unittest import mock
+
+_ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(_ROOT))
+
+from data import edgar_client as ec  # noqa: E402
+
+
+def row(start, end, val, filed="2026-08-01", form="10-Q", accn="a1"):
+    return {
+        "start": start,
+        "end": end,
+        "val": val,
+        "filed": filed,
+        "form": form,
+        "accn": accn,
+    }
+
+
+def facts(**concepts):
+    return {
+        "facts": {"us-gaap": {k: {"units": {"USD": v}} for k, v in concepts.items()}}
+    }
+
+
+# A calendar-year filer: quarters for Q1-Q3, the 10-K gives only the full year;
+# cash flow is year-to-date in the 10-Qs.
+REV = [
+    row("2025-01-01", "2025-03-31", 100),
+    row("2025-04-01", "2025-06-30", 110),
+    row("2025-07-01", "2025-09-30", 120),
+    row("2025-01-01", "2025-12-31", 460, form="10-K"),  # Q4 = 460-330 = 130
+    row("2026-01-01", "2026-03-31", 140),
+    row("2026-04-01", "2026-06-30", 150),
+]
+OCF = [
+    row("2025-01-01", "2025-03-31", 10),
+    row("2025-01-01", "2025-06-30", 25),
+    row("2025-01-01", "2025-09-30", 40),
+    row("2025-01-01", "2025-12-31", 60, form="10-K"),
+    row("2026-01-01", "2026-03-31", 20),
+    row("2026-01-01", "2026-06-30", 45),
+]
+
+
+class PeriodMath(unittest.TestCase):
+    def test_reported_quarter(self):
+        rows = ec.rows_for(facts(Revenues=REV), "revenue")
+        self.assertEqual(ec.quarter_value(rows, "2026-06-30"), 150)
+
+    def test_q4_derived_from_full_year(self):
+        rows = ec.rows_for(facts(Revenues=REV), "revenue")
+        self.assertEqual(ec.quarter_value(rows, "2025-12-31"), 130)  # 460 - 330
+        rows9 = ec.rows_for(
+            facts(Revenues=REV + [row("2025-01-01", "2025-09-30", 330)]), "revenue"
+        )
+        self.assertEqual(ec.quarter_value(rows9, "2025-12-31"), 130)  # FY - 9M YTD
+        partial = [r for r in rows if r["end"] != "2025-09-30"]
+        self.assertIsNone(ec.quarter_value(partial, "2025-12-31"))  # can't derive
+
+    def test_ytd_cash_flow_quarter_and_ttm(self):
+        rows = ec.rows_for(
+            facts(NetCashProvidedByUsedInOperatingActivities=OCF), "op_cash_flow"
+        )
+        self.assertEqual(ec.quarter_value(rows, "2026-06-30"), 25)  # 45 - 20
+        self.assertEqual(ec.ttm_value(rows, "2026-06-30"), 80)  # 60 + 45 - 25
+
+    def test_ttm_reported_annual(self):
+        rows = ec.rows_for(facts(Revenues=REV), "revenue")
+        self.assertEqual(ec.ttm_value(rows, "2025-12-31"), 460)
+
+    def test_amendment_latest_filed_wins(self):
+        amended = REV + [
+            row("2026-04-01", "2026-06-30", 155, filed="2026-09-01", form="10-Q/A")
+        ]
+        rows = ec.rows_for(facts(Revenues=amended), "revenue")
